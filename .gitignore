# ==============================================================================
# .gitignore: Git 버전 관리 제외 목록 파일
# ==============================================================================

# 1. 의존성 라이브러리 폴더 제외
node_modules/
package-lock.json

# 2. [보안 최우선] 환경 변수 및 비밀 키 파일 절대 업로드 금지
.env
.env.local
.env.*.local

# 3. 로그 및 임시 파일
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

